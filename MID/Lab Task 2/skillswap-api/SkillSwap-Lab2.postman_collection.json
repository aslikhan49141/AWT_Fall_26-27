{
  "info": {
    "name": "SkillSwap Lab Task 2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "categoryId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. POST (valid data)",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Response has id\", function () { pm.expect(pm.response.json()).to.have.property(\"id\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alif Shahriar Likhan\",\n  \"email\": \"alif{{$timestamp}}@example.com\",\n  \"password\": \"secret123\",\n  \"bio\": \"CSE student at AIUB\",\n  \"location\": \"Dhaka\"\n}"
            }
          }
        },
        {
          "name": "Create Skill Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"categoryId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/skill-categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "skill-categories"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Programming {{$timestamp}}\",\n  \"description\": \"Software development skills\"\n}"
            }
          }
        },
        {
          "name": "Create Skill",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/skills",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "skills"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"React.js\",\n  \"description\": \"Frontend JavaScript library\",\n  \"categoryId\": {{categoryId}}\n}"
            }
          }
        }
      ]
    },
